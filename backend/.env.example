# ──────────────────────────────────────────────────────────────────────────────
# Bridgr backend — environment variable reference
# Copy this file to .env and fill in real values.  Variables with a non-empty
# default below work out-of-the-box for local development without any keys.
# ──────────────────────────────────────────────────────────────────────────────


# ── Auth (Firebase) ───────────────────────────────────────────────────────────
# Option A: path to a downloaded Firebase service-account JSON file.
# Leave blank if using Option B (individual env vars) instead.
# Without Firebase configured, /api/user/* routes will return 503.
FIREBASE_CREDENTIALS_PATH=

# Option B: individual service-account fields (used when the JSON file path is
# not set).  All three must be present for Firebase to initialise.
# Leave blank to run in auth-disabled / fallback mode.
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=


# ── Database ──────────────────────────────────────────────────────────────────
# SQLAlchemy connection URL.  Defaults to a local SQLite file (bridgr.db) when
# unset — fine for development.  Set a postgres:// URL for production.
# If empty, all analysis-persistence calls will fail silently.
DATABASE_URL=sqlite:///./bridgr.db


# ── LLM fallback ─────────────────────────────────────────────────────────────
# Gemini (primary).  Leave blank to skip Gemini calls; Groq will be tried next.
GEMINI_API_KEY=

# Groq (secondary fallback).  Leave blank to disable Groq; static fallback used.
GROQ_API_KEY=

# OpenAI — referenced by core_ml/loader.py config dict but not actively called
# in the current codebase.  Safe to leave blank.
OPENAI_API_KEY=


# ── Supabase (legacy / optional) ──────────────────────────────────────────────
# Not required for the SQLAlchemy DB path.  Only needed if a Supabase client is
# used directly (currently only referenced in core/config.py as future-use).
SUPABASE_URL=
SUPABASE_KEY=


# ── ML data ───────────────────────────────────────────────────────────────────
# Path where the extracted O*NET db_* folder lives.  If unset, falls back to
# backend/data/ then the bundled 50-occupation sample CSV.
# Without full O*NET data, DATA_MODE will be "sample" or "fallback".
ONET_EXTRACT_PATH=data/

# Path to the O*NET ZIP archive; the loader will extract it on first run.
# Leave blank if the data is already extracted.
ONET_ZIP_PATH=

# Cosine-similarity threshold for semantic skill matching (0.0–1.0).
SEMANTIC_THRESHOLD=0.75

# Fraction of jobs a skill must appear in to be considered "high demand".
HIGH_DEMAND_THRESHOLD=0.15

# Base data directory (used by some ML helpers as a fallback).
DATA_DIR=data/


# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of EXACT-match origins allowed by CORSMiddleware.
# Do NOT include wildcard entries like https://*.vercel.app here — they will
# never match (CORSMiddleware does exact string comparison).  Use
# ALLOWED_ORIGIN_REGEX for dynamic subdomains instead.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional Python regex applied via CORSMiddleware's allow_origin_regex
# parameter.  Covers preview/staging deployments with dynamic subdomains.
# Leave blank to disable regex matching entirely.
ALLOWED_ORIGIN_REGEX=https://.*\.(vercel|netlify|onrender)\.app


# ── App ───────────────────────────────────────────────────────────────────────
# Set to true only in development — exposes /debug/cors and enables verbose
# logging.  Must be false (or unset) in production.
DEBUG=false

ENVIRONMENT=development
APP_NAME=Bridgr
