# Safe defaults for docker-compose — no secrets, no keys.
# Override with real values by setting environment variables in docker-compose.yml
# or by mounting a real .env at runtime.

# ML / Data
ONET_EXTRACT_PATH=/app/backend/data
ONET_ZIP_PATH=
SEMANTIC_THRESHOLD=0.75
DATA_DIR=/app/backend/data

# API keys — empty means sample/fallback mode; set real values for LLM fallback
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Database — SQLite by default (no external DB needed)
DATABASE_URL=sqlite:///./bridgr.db

# Auth — Firebase disabled by default; set to enable
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# CORS — exact-match origins (comma-separated, no wildcards)
ALLOWED_ORIGINS=http://localhost:3000
# CORS regex for dynamic preview subdomains (leave empty to disable)
ALLOWED_ORIGIN_REGEX=

# App
ENVIRONMENT=development
DEBUG=true
