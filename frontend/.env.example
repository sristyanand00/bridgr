# ──────────────────────────────────────────────────────────────────────────────
# Bridgr frontend — environment variable reference
# Copy this file to .env and fill in real values.
# All REACT_APP_FIREBASE_* vars are optional; if any of the three required ones
# (API_KEY, AUTH_DOMAIN, PROJECT_ID) are missing, a mock Firebase implementation
# is used automatically and auth features will not persist across sessions.
# ──────────────────────────────────────────────────────────────────────────────


# ── Backend API ───────────────────────────────────────────────────────────────
# URL of the Bridgr backend.  Without this, API calls will fail.
REACT_APP_API_URL=http://localhost:8000

# Environment label used for conditional behaviour in the app.
REACT_APP_ENV=development


# ── Firebase (optional) ───────────────────────────────────────────────────────
# Get these values from the Firebase console → Project settings → Your apps.
# Without API_KEY + AUTH_DOMAIN + PROJECT_ID the app uses a mock auth layer.

# Web API key from Firebase project settings.
REACT_APP_FIREBASE_API_KEY=

# Firebase auth domain (usually <project-id>.firebaseapp.com).
REACT_APP_FIREBASE_AUTH_DOMAIN=

# Firebase project ID.
REACT_APP_FIREBASE_PROJECT_ID=

# Default Cloud Storage bucket (optional — only needed if using Firebase Storage).
REACT_APP_FIREBASE_STORAGE_BUCKET=

# Cloud Messaging sender ID (optional — only needed for push notifications).
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=

# Firebase app ID.
REACT_APP_FIREBASE_APP_ID=

# Google Analytics measurement ID (optional).
REACT_APP_FIREBASE_MEASUREMENT_ID=

# ── Dev-only mock auth ────────────────────────────────────────────────────────
# DEV ONLY. Never set this in a deployed environment.
# When set to true AND NODE_ENV=development, the app uses a mock Firebase
# implementation so you can run the frontend without real Firebase credentials.
# All auth operations will succeed locally but no real user is created.
# In production (or any environment where REACT_APP_FIREBASE_* keys are absent
# and this is not set), auth is disabled and a console.error is shown instead.
REACT_APP_ALLOW_MOCK_AUTH=
