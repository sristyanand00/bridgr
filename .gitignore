# Python
__pycache__/
*.py[cod]
*.pkl
.env
venv/
.venv/

# Node
node_modules/
dist/
build/
.env.local

# Data (too large for git) — exclude contents but NOT specific subdirectories
data/*
!data/sample/
!data/sample/**
*.csv

# Ship the backend sample so `git clone && docker-compose up` works without setup
# Note: negations must target individual files, not re-include excluded parents.
# Using data/* instead of data/ so the sample/ subdirectory can be re-included.
!backend/data/
!backend/data/sample/
!backend/data/sample/**

# VS Code
.vscode/

# Database
*.db
*.sqlite
*.sqlite3

# Firebase credentials (sensitive)
firebase-admin-key.json
firebase-service-account.json
*-service-account.json

# OS
.DS_Store
Thumbs.db